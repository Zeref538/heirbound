# Unity generated folders. All of these are rebuilt from Assets/ and
# ProjectSettings/ on the next open, so committing them is pure noise.
# The Unity project lives in HeirboundGame/, so the paths say so: a bare
# /[Ll]ibrary/ only matches at the repo root and would let 3.5 GB through.
/HeirboundGame/[Ll]ibrary/
/HeirboundGame/[Tt]emp/
/HeirboundGame/[Oo]bj/
/HeirboundGame/[Bb]uild/
/HeirboundGame/[Bb]uilds/
/HeirboundGame/[Ll]ogs/
/HeirboundGame/[Uu]ser[Ss]ettings/
/HeirboundGame/[Mm]emoryCaptures/
/HeirboundGame/[Rr]ecordings/

# Loose generator downloads: exact copies of files already in source-art/.
/*.png

# Personal Claude Code settings and a third-party skill (unknown licence).
.claude/

# Never in git, always regenerated by the IDE
*.csproj
*.sln
*.user
*.unityproj
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vscode/
.idea/

# Build output
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Python
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db
